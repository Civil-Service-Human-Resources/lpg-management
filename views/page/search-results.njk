{% from "../component/list/macro.njk" import list with context %}
{% from "../component/menu/macro.njk" import menu %}
{% from "../component/search/macro.njk" import search with context %}
{% from "pagination/macro.njk" import govukPagination %}
{% from "../component/searchFilters/macro.njk" import searchFilters %}

{% extends "../component/Page.njk" %}

{% block pageTitle %}{{ i18n['content_management_title'] }} - {{ i18n['proposition_name'] }}{% endblock %}

{% set banner = true %}
{% set currentTab = 'admin' %}

{% macro searchResults(results, total) %}
    {% if total > 2 %}
        {% set multiple = 's' %}
    {% else  %}
        {% set multiple = '' %}
    {% endif %}
    {% set listTitle =  total + ' result' + multiple + ' found'  %}
    {{ list({
        "title": {
            "text": listTitle
        },
        "courses": results,
        "showModuleCounts": true,
        "showShortDescription": true,
        "showEdit": true,
        "showStatus": true
    }) }}
{% endmacro %}

{% block content %}
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-full">
            <div class="header-search">
                <h1 class="govuk-heading-l">Search results</h1>
                {{ search({
                    "query": pageModel.query
                }) }}
            </div>
        </div>
    </div>

    <div class="govuk-grid-row">
        <div class='govuk-grid-column-one-third'>
            {{ searchFilters({
                "query": pageModel.query,
                "filters": [
                    {
                        "id": "course-status",
                        "name": "status",
                        "heading": "Course status",
                        "items": pageModel.filters.selectedStatuses
                    },
                    {
                        "id": "course-visibility",
                        "name": "visibility",
                        "heading": "Course visibility",
                        "items": pageModel.filters.selectedVisibility
                    },
                    {
                        "id": "learning-type",
                        "name": "courseType",
                        "heading": "Learning type",
                        "items": pageModel.filters.selectedLearningTypes
                    },
                    {
                        "id": "cost",
                        "name": "cost",
                        "heading": "Cost",
                        "items": [
                        {
                            "id": "cost",
                            "value": "free",
                            "label": "Show only free",
                            "checked": pageModel.filters.showFree
                        }
                    ]
                    }
                ]
            }) }}
        </div>
        <div class="govuk-grid-column-two-thirds search-results-row">
        {% if pageModel.searchResults %}
            {% if pageModel.pagination.total !== 0 %}
                {{ searchResults(pageModel.searchResults, pageModel.pagination.total) }}
            {% else %}
                <p class="govuk-body"><strong>0</strong> results found</p>
                <h2 class="govuk-heading-m custom"><strong>Please try:</strong></h2>
                <ul class="zero-results">
                    <li>searching again using different words</li>
                    <li>searching again using fewer words</li>
                </ul>
            {% endif %}
        {% endif %}
        </div>
    </div>
    {% if pageModel.pagination.total !== 0 %}
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-two-thirds">
                <p class="govuk-body">Showing {{ pageModel.pagination.start }} - {{ pageModel.pagination.end }} of {{ pageModel.pagination.total }}</p>
                {{ govukPagination({
                    previous: {
                        href: pageModel.pagination.prevLink
                    },
                    next: {
                        href: pageModel.pagination.nextLink
                    },
                    items: pageModel.pagination.numberedPages
                }) }}
            </div>
        </div>
    {% endif %}
{% endblock %}
