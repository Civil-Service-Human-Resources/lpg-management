{% from "../../component/pagination/macro.njk" import pagination with context %}
{% from "../../component/hyperlinkManager/macro.njk" import hyperlinkManager with context %}

{% extends "./manage-content-base.njk" %}

{% block pageTitle %}
    {{ i18n.learningTags.title.viewCourses }} - {{ i18n.proposition_name }}
{% endblock %}

{% set selectedTab = "links" %}

{% block tabContent %}
    {% set searchHeaderHtml %}
        <div class="header-search">
            <h2 class="govuk-heading-m">Links assigned to this tag</h2>
        </div>
    {% endset %}
    {% if pageModel.results.length > 0 %}
        {{ hyperlinkManager({
            "submitAction": "/content-management/learning-tags/" + learningTag.id  + "/hyperlinks/remove",
            "legend": {
                "html": "<h2 class=\"govuk-heading-m\">Links assigned to this tag</h2>"
            },
            "links": pageModel.results,
            allIds: pageModel.allIds
        }) }}
        <p class="govuk-body">Showing {{ hyperlinksPageModel.pagePagination.start }} - {{ hyperlinksPageModel.pagePagination.end}} of {{ hyperlinksPageModel.pagePagination.total }}</p>
        {{ pagination(hyperlinksPageModel.pagePagination.pagination) }}
    {% else %}
        {{ searchHeaderHtml | safe }}
        <p class='govuk-body'>There are currently no links assigned to this tag</p>
    {% endif %}
{% endblock %}

{% block bodyEnd %}
    <script type="text/javascript" src="/js/main-bundle.min.js"></script>
{% endblock %}