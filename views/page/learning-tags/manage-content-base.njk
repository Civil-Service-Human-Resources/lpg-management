{% from "../../component/search/macro.njk" import search with context %}
{% from "../../component/pagination/macro.njk" import pagination with context %}
{% from "../../component/courseManager/macro.njk" import courseManager with context %}
{% from "../../component/hyperlinkManager/macro.njk" import hyperlinkManager with context %}
{% from "checkboxes/macro.njk" import govukCheckboxes %}

{% extends "../../component/Page.njk" %}

{% block pageTitle %}
    {{ i18n.learningTags.title.viewCourses }} - {{ i18n.proposition_name }}
{% endblock %}

{% set banner = true %}
{% set backButton = "/content-management/learning-tags/" + learningTag.id + "/overview" %}
{% set removeResultsBanner = sessionFlash.removeResultsBanner if sessionFlash.removeResultsBanner else removeResultsBanner %}

{% block content %}
    {% if pageModel and pageModel.errors %}
        {% set errors = pageModel.errors %}
    {% endif %}
    {{ errorSummary(errors.fields) }}
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-full">
            {% if removeResultsBanner %}
                <div class="panel panel-blue">
                    <div class="govuk-panel__body custom-panel panel-blue">
                        <p class="govuk-body">
                            {{ removeResultsBanner }}
                        </p>
                    </div>
                </div>
            {% endif %}
            {% block extraBanner %}
            {% endblock %}
            <h1 class="page-title govuk-heading-l">{{learningTag.name}}</h1>
            <div class="govuk-tabs">
                <h2 class="govuk-tabs__title">Contents</h2>
                <ul class="govuk-tabs__list">
                    {% for tab in [
                        {
                            href: "/content-management/learning-tags/" + learningTag.id + "/courses",
                            text: "Courses assigned to this tag",
                            selected: selectedTab === "courses"
                        },
                        {
                            href: "/content-management/learning-tags/" + learningTag.id + "/hyperlinks",
                            text: "Links assigned to this tag",
                            selected: selectedTab === "links"
                        }
                    ] %}
                        <li class="govuk-tabs__list-item {% if tab.selected %}govuk-tabs__list-item--selected{% endif %}">
                            <a class="govuk-tabs__tab" href="{{ tab.href }}">
                                {{ tab.text }}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
                <div class="govuk-tabs__panel" id="courses">
                    {% block tabContent %}
                    {% endblock %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block bodyEnd %}
    <script type="text/javascript" src="/govuk-frontend/all.js"></script>
    <script>window.GOVUKFrontend.initAll()</script>
    <script type="text/javascript" src="/js/main-bundle.min.js"></script>
    <script>document.body.className = ((document.body.className) ? document.body.className + ' js-enabled' : 'js-enabled');</script>
{% endblock %}