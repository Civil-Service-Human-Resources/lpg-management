{% extends "./base.njk" %}
{% from "button/macro.njk" import govukButton %}
{% from "../../component/learningTagsAutocomplete.njk" import learningTagsAutocomplete %}

{% set backButton = "/content-management/learning-tags/assign/select-learning-tags" %}
{% block h2 %}{{ i18n.learningTags.title.searchForCourses }}{% endblock %}
{% block assignContent %}
    <form method="post" action="/content-management/learning-tags/assign-courses/select-courses">
        <div id="course-completions-autocomplete" class="autocomplete-wrapper--single-page">
            <label class="govuk-label" for="courseSearch">All courses</label>
            <div id="subject-hint" class="govuk-hint">
                <span id="autocomplete-js-hint" class='hidden'>Start typing to filter available courses.</span> You can select up to {{ pageModel.maxCoursesSelection}} courses.
            </div>
            <select id="courseSearch" name="courseSearch" class="govuk-input" aria-labelledby="courseSearch" multiple>
                {% for course in pageModel.courseList %}
                    <option {% if  (pageModel.courseSearch or []).indexOf(course.id) > -1 %}selected{% endif %} value={{ course.id }}>{{ course.name }}</option>
                {% endfor %}
            </select>
        </div>
        <input type="hidden" name="_csrf" value="{{ _csrf }}">
        {{ govukButton({
            text: "Continue",
            preventDoubleClick: true
        }) }}
    </form>
{% endblock %}
