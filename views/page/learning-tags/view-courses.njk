{% from "../../component/search/macro.njk" import search with context %}
{% from "../../component/pagination/macro.njk" import pagination with context %}
{% from "../../component/courseManager/macro.njk" import courseManager with context %}
{% from "checkboxes/macro.njk" import govukCheckboxes %}
{% from "tabs/macro.njk" import govukTabs %}

{% extends "../../component/Page.njk" %}

{% block pageTitle %}
    {{ i18n.learningTags.title.viewCourses }} - {{ i18n.proposition_name }}
{% endblock %}

{% set banner = true %}
{% set backButton = "/content-management/learning-tags/" + learningTag.id + "/overview" %}
{% set removeCourseResults = sessionFlash.removeCourseResults if sessionFlash.removeCourseResults else removeCourseResults %}

{% block content %}
    {% set errors = pageModel.errors %}
    {{ errorSummary(errors.fields) }}
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-full">
            <h1 class="page-title govuk-heading-l">{{learningTag.name}}</h1>
            {% if removeCourseResults %}
                <div class="panel panel-blue">
                    <div class="govuk-panel__body custom-panel panel-blue">
                        <p class="govuk-body">
                            {% if removeCourseResults.successfulIds.length === 1 %}
                                1 course was removed from this tag.
                            {% else %}
                                {{ removeCourseResults.successfulIds.length }} courses were removed from this tag.
                            {% endif %}
                        </p>
                    </div>
                </div>
            {% endif %}
            {% set coursesHtml %}
                {% set searchHeaderHtml %}
                    <div class="header-search">
                        <h2 class="govuk-heading-m">Courses assigned to this tag</h2>
                    </div>
                {% endset %}
                {% if pageModel.results.length > 0 %}
                    {{ courseManager({
                            "submitAction": "/content-management/learning-tags/" + learningTag.id  + "/courses/remove",
                            "legend": {
                                "html": "<h2 class=\"govuk-heading-m\">Courses assigned to this tag</h2>"
                            },
                            "courses": pageModel.results,
                            allIds: pageModel.allIds
                        }) }}
                    <p class="govuk-body">Showing {{ pageModel.pagePagination.start }} - {{ pageModel.pagePagination.end}} of {{ pageModel.pagePagination.total }}</p>
                    {{ pagination(pageModel.pagePagination.pagination) }}
                {% else %}
                    {{ searchHeaderHtml | safe }}
                    <p class='govuk-body'>There are currently no courses assigned to this tag</p>
                {% endif %}
            {% endset %}
            {% set hyperlinksHtml %}
                <div class="header-search">
                    <h2 class="govuk-heading-m">Links assigned to this tag</h2>
                </div>
                {% if hyperlinks and hyperlinks.results and hyperlinks.results.length > 0 %}
                    <ul class="list">
                        {% for link in hyperlinks.results %}
                            <li class="list-details u--border--bgrey">
                                <p class="govuk-body">{{ link.title }}</p>
                                <a class="govuk-link" href="{{ link.href }}" target="_blank" rel="noreferrer noopener">
                                    Go to {{ link.title }} (opens in a new tab)
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                    {% if hyperlinksPagination and hyperlinksPagination.total > 0 %}
                        <p class="govuk-body">Showing {{ hyperlinksPagination.start }} - {{ hyperlinksPagination.end}} of {{ hyperlinksPagination.total }}</p>
                        {{ pagination(hyperlinksPagination.pagination) }}
                    {% endif %}
                {% else %}
                    <p class='govuk-body'>There are currently no links assigned to this tag</p>
                {% endif %}
            {% endset %}
            {{ govukTabs({
                items: [
                    {
                        label: "Courses assigned to this tag",
                        id: "courses",
                        panel: {
                            html: coursesHtml
                        }
                    },
                    {
                        label: "Links assigned to this tag",
                        id: "links",
                        panel: {
                            html: hyperlinksHtml
                        }
                    }
                ]
            }) }}
        </div>
    </div>
{% endblock %}

{% block bodyEnd %}
    <script src="/govuk-frontend/all.js"></script>
    <script>window.GOVUKFrontend.initAll()</script>
    <script type="text/javascript" src="/js/main-bundle.min.js"></script>
{% endblock %}