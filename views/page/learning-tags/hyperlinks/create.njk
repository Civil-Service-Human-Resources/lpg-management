{% from "button/macro.njk" import govukButton %}

{% extends "../../../component/Page.njk" %}

{% block pageTitle %}
    {{ i18n.learningTags.title.createHyperlink }} - {{ i18n.proposition_name }}
{% endblock %}

{% set banner = true %}
{% set backButton = "/content-management/learning-tags/assign-hyperlinks/select-learning-tag" %}

{% block content %}
    {% set errors = pageModel.errors %}
    {{ errorSummary(errors.fields, true) }}
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <h1 class="page-title govuk-heading-l">{{ i18n.learningTags.title.assignLinkToTag }}</h1>
            <h2 class="govuk-heading-m">{{ i18n.learningTags.title.createLink }}</h2>
            <form method="post" action="/content-management/learning-tags/{{ learningTag.id }}/hyperlinks">
                {% include "./add-edit-form.njk" %}
                {{ govukButton({
                    text: "Continue"
                }) }}
            </form>
        </div>
    </div>
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <a href="/content-management/learning-tags/manage" class="govuk-link">Cancel</a>
        </div>
    </div>
{% endblock %}

{% block bodyEnd %}
    <script type="text/javascript" src="/js/main-bundle.min.js"></script>
{% endblock %}