{% from "../../component/list/macro.njk" import list %}
{% from "../../component/menu/macro.njk" import menu %}
{% from "../../component/statusWithLabel/macro.njk" import statusWithLabel with context %}
{% from "../../component/changeStatus/macro.njk" import changeStatus with context %}
{% from "../../component/courseEvents/macro.njk" import courseEvents with context %}
{% from "../../component/audiences/macro.njk" import audiences with context %}
{% from "../../component/backToTop/macro.njk" import backToTop %}
{% from "summary-list/macro.njk" import govukSummaryList %}
{% from "back-link/macro.njk" import govukBackLink %}
{% from "button/macro.njk" import govukButton %}
{% from "details/macro.njk" import govukDetails %}

{% extends "../../component/Page.njk" %}

{% block pageTitle %}{{ i18n['course_overview_title'] }} - {{ i18n['proposition_name'] }}{% endblock %}

{% set banner = true %}
{% set backButton = "/content-management" %}

{% block content %}
{% set courseSuccessMessage = sessionFlash.courseSuccessMessage%}
{% if courseSuccessMessage %}
<div class="panel panel-blue" role="status">
    <span class="panel__heading">{{ course.title }}</span>
    <p class="govuk-body no-margin">{{ i18n[courseSuccessMessage] }}</p>
</div>
{% endif %}
<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        <h1 class="govuk-heading-l">{{ course.title }}</h1>
    </div>
</div>
<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <div class="course-container">
            <h2 class="govuk-heading-m">Course overview</h2>
            {% block courseDetails %}
                {{ govukSummaryList({
                    rows: [
                        {
                            key: {
                                text: "Type"
                            },
                            value: {
                                text: i18n[course.type] | default("Course", true)
                            }
                        },
                        {
                            key: {
                                text: "Cost"
                            },
                            value: {
                                text: "£" + course.costInPounds if course.costInPounds else "Free"
                            }
                        },
                        {
                            key: {
                                text: "Level"
                            },
                            value: {
                                text: course.level | capitalize | default("Unspecified", true)
                            }
                        },
                        {
                            key: {
                                text: "Grades"
                            },
                            value: {
                                text: course.grades | join(", ") if grades.length > 0 else "Unspecified"
                            }
                        },
                        {
                            key: {
                                text: "Course visibility"
                            },
                            value: {
                                text: course.visibility | capitalize | default("Unspecified", true)
                            }
                        }
                    ]
                }) }}
            {% endblock %}
        </div>
        <div class="section">
            <h2 class="govuk-heading-m">Course events</h2>
            {% block courseEvents %}
                {{ courseEvents(course, course.faceToFaceModuleOverviews, identity) }}
            {% endblock %}
        </div>
        <div class="section">
            <div class="title-container">
                <h2 class="govuk-heading-m">Course audiences</h2>
                {% if course.status !== "Archived" and identity.hasLearningEdit() %}
                <form action="/content-management/courses/{{ course.id }}/audiences/" method="post">
                    <input type="hidden" name="_csrf" value="{{ _csrf }}">
                    <button class="govuk-link linkish-button add-audience-link" id="name" name="name" value="temp-audience-name">Add an audience</button>
                </form>
                {% endif %}
            </div>
            {% block audiences %}
                {% if course.audiences %}
                    <ul class='audience-list'>
                        {% for audience in course.audiences %}
                            {% if params.audience.name != '' %}
                                <li class="list-item">
                                    <div class="title-container">
                                        <h3 class="govuk-heading-s">{{ audience.name | default("Audience", true) }}</h3>
                                        {% if course.status !== "Archived" and identity.hasLearningEdit() %}
                                            <a class="govuk-body govuk-link edit-audience-link" href="/content-management/courses/{{course.id}}/audiences/{{audience.id}}/configure">Edit</a>
                                        {% endif %}
                                    </div>
                                    {{ govukDetails({
                                        summaryText: 'View audience details',
                                        html: audiences(audience)
                                    }) }}
                                </li>
                            {% else %}
                                <li class="list-item">
                                    <div class="title-container">
                                        <h3 class="govuk-heading-s">This audience has not been configured</h3>
                                        {% if course.status !== "Archived" and identity.hasLearningEdit() %}
                                            <a class="govuk-body govuk-link edit-audience-link" href="/content-management/courses/{{course.id}}/audiences/{{audience.id}}/configure">Configure</a>
                                        {% endif %}
                                    </div>
                               </li>
                            {% endif %}
                        {% endfor %}
                    </ul>
                {% else %}
                    <p class="govuk-body">This course has no audiences yet.</p>
                {% endif %}
            {% endblock %}
        </div>
    </div>
    <div class="govuk-grid-column-one-third">
        <div class="right-menu">
            {% block statusWithLabel %}
                {{ statusWithLabel(course.status) }}
            {% endblock %}
            {% block changeStatus %}
                {{ changeStatus(course.status) }}
            {% endblock %}
            {% if course.status !== "Archived" %}
                {% block menu %}
                    {% set actions = [] %}
                    {% if identity.hasLearningEdit() %}
                        {% set action = actions.push({
                                link: '/content-management/courses/' + course.id + "/preview",
                                text: "Preview and edit",
                                visuallyHiddenText: course.title
                            }) %}
                    {% endif %}
                    {% if course.canBeDeleted() and identity.hasLearningDelete() %}
                        {% set action = actions.push({
                                link: '/content-management/courses/delete/' + course.id,
                                text: 'Delete this course'
                        }) %}
                    {% endif %}

                    {% if actions | length > 0 %}
                        {{ menu("Actions", actions) }}
                    {% endif %}

                    {% set linkActions = [
                        {
                            link: courseUrl,
                            text: 'View this course on Civil Service Learning',
                            openInNewTab: true
                        }
                    ] %}
                    {{ menu("Course link", linkActions) }}

                    {% if course.status === "Published" %}
                        <div id="course-copy" class="js-only copy-link govuk-!-padding-2">
                            <input type='hidden' name='course-link' class='copy-link__link' value='{{ courseUrl }}'>
                            {{ govukButton({
                                text: "Copy link to clipboard",
                                "classes": "govuk-button--secondary copy-link__button govuk-!-margin-0"
                            }) }}
                            <div class="govuk-body govuk-!-margin-top-2 copy-link__notification" role="status"></div>
                        </div>
                    {% endif %}
                {% endblock %}
            {% endif %}
        </div>
    </div>
</div>
<div class='govuk-grid-row'>
    <div class='govuk-grid-column-full'>
        {{ backToTop() }}
    </div>
</div>
{% endblock %}

{% block bodyEnd %}
<script src='/js/main-bundle.min.js'></script>
{% endblock %}