{% from "summary-list/macro.njk" import govukSummaryList %}

{% set requiredLearningHtml %}
    <div class='audience-info'>
        {% if params.requiredBy %}
            <div>
                Deadline: {{ params.requiredBy }}
            </div>
        {% endif %}
        {% if params.frequency %}
            <div>
                Occurs every: {{ params.frequency }}
            </div>
        {% endif %}
        {% if not params.frequency and not params.requiredBy %}
            No required learning has been added
        {% endif %}
    </div>
{% endset %}

{% macro joinListOrDefault(list, default) %}
    {{ list | join(', ') if list.length > 0 else default }}
{% endmacro %}

{{ govukSummaryList({
    rows: [
        {
            key: {
                text: "Audience type"
            },
            value: {
                text: i18n.audience.type[params.type] | default("Unspecified", true),
                classes: "audience-info"
            }
        },
        {
            key: {
                text: "Organisations"
            },
            value: {
                text: joinListOrDefault(params.organisations, "No organisations have been added"),
                classes: "audience-info"
            }
        },
        {
            key: {
                text: "Grades"
            },
            value: {
                text: joinListOrDefault(params.grades, "No grades have been added"),
                classes: "audience-info"
            }
        },
        {
            key: {
                text: "Area of work"
            },
            value: {
                text: joinListOrDefault(params.areasOfWork, "No areas of work have been added"),
                classes: "audience-info"
            }
        },
        {
            key: {
                text: "Interests"
            },
            value: {
                text: joinListOrDefault(params.interests, "No core learning has been added"),
                classes: "audience-info"
            }
        },
        {
            key: {
                text: "Required learning"
            },
            value: {
                html: requiredLearningHtml
            }
        }
    ]
}) }}