{% from "../contentManager/macro.njk" import contentManager with context %}
{% set items = [] %}
{% for link in (params.links or params.hyperlinks) %}
    {% set items = (items.push({
        id: link.id,
        name: link.id,
        value: link.id,
        text: link.title,
        title: link.title,
        view: {
            text: "Go to " + link.title,
            href: link.url
        },
        secondaryActions: [
            {
                text: 'Edit link',
                href: params.baseUrl + "/" + link.id
            },
            {
                remove: {
                    text: "Remove link",
                    formaction: params.submitAction + "/" + link.id
                }
            }
        ],
        checked: (params.selectedIds or []).includes(link.id)
    }), items) %}
{% endfor %}
{{ contentManager({
    "type": "link",
    "name": "hyperlinkIds",
    "submitAction": params.submitAction,
    "allIds": params.allIds,
    "legend": {
        "html": params.legend.html
    },
    "items": items
}) }}
